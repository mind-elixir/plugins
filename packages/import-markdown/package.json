{
  "name": "@mind-elixir/import-markdown",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "description": "Import Markdown documents into MindElixir format",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "test": "node --experimental-strip-types src/__tests__/regression.ts",
    "test:parity": "node --experimental-strip-types src/__tests__/parity.mjs"
  },
  "dependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "rehype-stringify": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@mind-elixir/typescript-config": "workspace:*",
    "mind-elixir": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "keywords": [
    "markdown",
    "mindmap",
    "mind-elixir",
    "import"
  ],
  "author": "Mind Elixir",
  "license": "MIT"
}